{
  "tracker": "github",
  "github": {
    "repo": "{{REPO}}"
  },
  "agent_cmd": "claude -p --output-format json --permission-mode acceptEdits --allowedTools \"Bash(python3 -m unittest:*),Bash(python3 -m pytest:*),Bash(git add:*),Bash(git commit:*),Bash(git status:*),Bash(git diff:*)\"",
  "prep_cmd": "claude -p --output-format json --allowedTools \"Read,Grep,Glob\"",
  "check_cmd": "python3 -m unittest discover -s tests",
  "review": "panel",
  "base_branch": "main",
  "integration_branch": "runway/integration",
  "notify_cmd": "osascript -e 'display notification \"{msg}\" with title \"Runway\"'",
  "agent_timeout_s": 1800
}
