# Everything make-app.sh needs to know about this app. No secrets here: signing and notarization come from the
# environment (RELEASING.md).
APP_NAME="__APP__"                 # executable, .app and release asset names; never change it after the first release
APP_DISPLAY_NAME="__DISPLAY__"     # Finder, menus, the disk image's name
APP_BUNDLE_ID="__BUNDLE_ID__"      # locked for good after the first release
APP_RELEASE_REPO="__REPO__"        # the GitHub repo whose releases carry the downloads and the update feed
APP_MIN_MACOS="14.0"
APP_MENU_BAR=__MENU_BAR__          # 1: menu bar app, no Dock icon
APP_SPARKLE_ACCOUNT="__SPARKLE_ACCOUNT__" # the keychain account of this app's Sparkle key (generate_keys --account)
APP_COPYRIGHT="Copyright __YEAR__ __OWNER__"
APP_CHECK_CMD="swift test"         # what a release runs first; a failure stops it
